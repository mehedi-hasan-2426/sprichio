{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "helpers:pinGitHubActionDigests"],
  "timezone": "Europe/Berlin",
  "schedule": ["before 6am on monday"],
  "minimumReleaseAge": "3 days",
  "prConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "automerge": false,
  "pinDigests": true,
  "packageRules": [
    {
      "description": "Group routine updates by package manager; retain manual review.",
      "matchUpdateTypes": ["minor", "patch", "digest", "pin", "pinDigest"],
      "groupName": "{{manager}} non-major updates"
    },
    {
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "description": "Preserve the existing TypeScript 6 compatibility ceiling until typescript-eslint supports TypeScript 7.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "matchPackageNames": ["next", "@next/*", "react", "react-dom", "@types/react*"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "Next.js and React"
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "schedule": ["at any time"],
    "minimumReleaseAge": "0 days",
    "automerge": false
  }
}
